# Copy to .env for local development. Never commit real values.
HOST=127.0.0.1
PORT=3410
# The runtime role. The database names its roles to the migrations through the
# openagency.migrator_role and openagency.runtime_role settings; see docs/deploy.md.
DATABASE_URL=postgresql://social_runtime:change-me@127.0.0.1:5432/openagency_social
# Used only by `pnpm db:migrate`; must be a different role from DATABASE_URL.
DATABASE_MIGRATION_URL=postgresql://social_migrator:change-me@127.0.0.1:5432/openagency_social
# At least 32 characters; the control plane sends it as a Bearer token.
SERVICE_TOKEN=
# JSON object: key id -> base64 of 32 random bytes. Keep old keys to read old tokens.
TOKEN_KEYS={"local-1":""}
TOKEN_KEY_ACTIVE=local-1
# JSON object: provider app secret reference -> app secret.
PROVIDER_APP_SECRETS={}
# Must be registered on the Meta app and served by your control plane's API.
META_REDIRECT_URI=https://api.example.com/api/social/connect/meta/callback
META_GRAPH_VERSION=v26.0
# Optional OAuth callbacks on the control plane's API. Without them, YouTube and
# Instagram-login channels can only be imported (`pnpm channel import`).
GOOGLE_REDIRECT_URI=
INSTAGRAM_REDIRECT_URI=
# The control plane's signed media route; needed for Instagram and the browser runner.
PUBLIC_MEDIA_URL=
# Optional browser runner (TikTok, X, LinkedIn, Threads, Pinterest, Reddit).
RUNNER_URL=
RUNNER_TOKEN=
# Optional AI answers (docs/api.md, "AI answers"). Without Anthropic no drafts are
# written; without Liquid every decision is left to a person.
ANTHROPIC_API_KEY=
LIQUID_API_KEY=
# Optional: where the control plane hears that a pull is due. https, or http on loopback.
CONTROL_PLANE_EVENTS_URL=
WORKER_ENABLED=true
WORKER_CONCURRENCY=2
# Slots of their own for video posts and browser jobs.
WORKER_VIDEO_SLOTS=1
WORKER_BROWSER_SLOTS=1
WORKER_POLL_MS=5000
# How long a stopping engine lets publishes in flight finish; under the orchestrator's kill timeout (docs/deploy.md).
SHUTDOWN_GRACE_MS=25000
